{
  "retailer": "target",
  "cookies": {},
  "variables": {
    "address_id": "REPLACE_WITH_SAVED_ADDRESS_ID",
    "payment_id": "REPLACE_WITH_SAVED_PAYMENT_ID"
  },
  "sequence": [
    "add_to_cart",
    "checkout",
    "pre_checkout",
    "place_order"
  ],
  "requests": [
    {
      "name": "add_to_cart",
      "method": "POST",
      "url": "https://carts.target.com/web_checkouts/v1/cart_items?field_groups=CART%2CCART_ITEMS%2CSUMMARY&key=REPLACE_API_KEY",
      "headers": {
        "accept": "application/json",
        "content-type": "application/json",
        "referer": "{{product_url}}"
      },
      "body": "{\"cart_item\":{\"item_channel_id\":\"10\",\"tcin\":\"{{tcin}}\",\"quantity\":{{quantity}}},\"cart_type\":\"REGULAR\",\"channel_id\":\"10\",\"shopping_context\":\"DIGITAL\"}",
      "extract": {},
      "expect_status": 201
    },
    {
      "name": "checkout",
      "method": "PUT",
      "url": "https://carts.target.com/web_checkouts/v1/cart?cart_type=REGULAR&field_groups=ADDRESSES%2CCART%2CCART_ITEMS%2CFINANCE_PROVIDERS%2CPROMOTION_CODES%2CSUMMARY&key=REPLACE_API_KEY",
      "headers": {
        "accept": "application/json",
        "content-type": "application/json",
        "referer": "https://www.target.com/cart"
      },
      "body": "{\"cart_type\":\"REGULAR\",\"shopping_context\":\"DIGITAL\",\"channel_id\":\"10\"}",
      "expect_status": 200
    },
    {
      "name": "pre_checkout",
      "method": "POST",
      "url": "https://carts.target.com/web_checkouts/v1/pre_checkout?cart_type=REGULAR&field_groups=ADDRESSES%2CCART%2CCART_ITEMS%2CDELIVERY_WINDOWS%2CFINANCE_PROVIDERS%2CPAYMENT_INSTRUCTIONS%2CPICKUP_INSTRUCTIONS%2CPROMOTION_CODES%2CSUMMARY&key=REPLACE_API_KEY",
      "headers": {
        "accept": "application/json",
        "content-type": "application/json",
        "referer": "https://www.target.com/checkout/start"
      },
      "body": "{\"cart_type\":\"REGULAR\",\"channel_id\":\"10\"}",
      "expect_status": 201
    },
    {
      "name": "place_order",
      "method": "POST",
      "url": "https://carts.target.com/web_checkouts/v1/checkout?cart_type=REGULAR&field_groups=ADDRESSES%2CCART%2CCART_ITEMS%2CFINANCE_PROVIDERS%2CPAYMENT_INSTRUCTIONS%2CPICKUP_INSTRUCTIONS%2CPROMOTION_CODES%2CSUMMARY&key=REPLACE_API_KEY",
      "headers": {
        "accept": "application/json",
        "content-type": "application/json",
        "referer": "https://www.target.com/checkout"
      },
      "body": "{\"cart_type\":\"REGULAR\",\"channel_id\":\"10\"}",
      "extract": {
        "reference_id": "orders.0.reference_id",
        "order_number": "orders.0.order_number",
        "order_id": "orders.0.order_id"
      },
      "success_contains": "reference_id",
      "expect_status": 200,
      "commits_order": true
    }
  ]
}
